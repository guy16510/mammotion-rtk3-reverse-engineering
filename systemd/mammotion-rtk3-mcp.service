[Unit]
Description=Mammotion RTK3 restricted MCP probe server
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=__REPO_DIR__
EnvironmentFile=/etc/mammotion-rtk3-mcp.env
ExecStart=/usr/bin/node __REPO_DIR__/src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=__REPO_DIR__/rtk3-captures /run /var/tmp
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
